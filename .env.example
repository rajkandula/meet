# MongoDB — leave unset to run in demo mode (seeded meetings, guest room links only).
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=converge

# Object storage for recordings and profile pictures: any S3-compatible bucket.
# The browser uploads straight to the bucket with a presigned PUT, so the bucket's
# CORS policy must allow PUT with a Content-Type header from your app's origin.
STORAGE_BUCKET=meet-recordings
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_ENDPOINT=https://s3.your-provider.example
STORAGE_PUBLIC_URL=https://media.your-domain.com

# WebRTC signaling server (realtime/server.mjs).
# These defaults match local development: `npm run dev` starts the signaling
# server on 3005 and the app on 3001. In production point REALTIME_WS_URL at the
# deployed signaling server (wss://...). REALTIME_SECRET must be the same value on
# the app and the signaling server; generate one with `openssl rand -hex 32`.
REALTIME_PORT=3005
REALTIME_WS_URL=ws://localhost:3005
REALTIME_SECRET=replace-with-a-long-random-secret
# Read by the signaling server: where to tell the app that an empty room ended,
# and how long an empty room waits before it is closed.
APP_URL=http://localhost:3001
AUTO_END_MINUTES=5

# Optional SFU for group calls — one connection per participant instead of a mesh,
# so calls scale past four people. Any hosted SFU with the sessions/tracks HTTPS API
# described in lib/sfu.ts. Without all three the room uses mesh peer-to-peer
# (fine for 1:1 calls and small groups).
REALTIME_SFU_API_URL=
REALTIME_SFU_APP_ID=
REALTIME_SFU_APP_SECRET=

# Hosted TURN (optional, recommended): a TURN service's credential endpoint
# (POST { ttl } with a bearer token, answers { iceServers }). Server-side only:
# exchanged for short-lived browser credentials on every room join.
# Without a TURN relay, calls fail on most home and mobile networks.
TURN_CREDENTIALS_URL=
TURN_API_TOKEN=

# Or any STUN/TURN server (e.g. your own coturn), configured statically.
# NEXT_PUBLIC_STUN_URL defaults to a public STUN server when empty.
NEXT_PUBLIC_STUN_URL=
NEXT_PUBLIC_TURN_URL=turns:turn.your-domain.com:5349
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=

# Optional cap on how long one room may run, in minutes, counted from the first
# join (e.g. 120 for two hours). Unset or 0 (the default) means no limit.
MEETING_TIME_LIMIT_MINUTES=

# Logging: debug | info (default) | warn | error
LOG_LEVEL=info
